# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# PostgreSQL Database Configuration (CasaOS / Self-Hosted Docker)
# ==============================================================================
# Connection string format:
DATABASE_URL="postgres://postgres:wartakarsa_password@postgres:5432/wartakarsa_db"

# Or individual connection parameters:
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD="wartakarsa_password"
PGDATABASE="wartakarsa_db"

# Optional: set to 'true' to start with empty database instead of sample seed
DISABLE_AUTO_SEED="false"
